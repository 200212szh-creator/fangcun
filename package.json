{
  "name": "personal-library",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:migrate": "tsx scripts/migrate.ts && tsx scripts/migrate-v2.ts",
    "db:migrate:rollback": "tsx scripts/rollback-migration.ts",
    "db:validate": "tsx scripts/validate-migration.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "runtime:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "runtime:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-fangcun.ps1",
    "runtime:backup": "set \"FANGCUN_DATA_DIR=D:\\方寸数据\" && set \"DATABASE_URL=D:\\方寸数据\\data\\library.db\" && node runtime/maintenance/database-maintenance.js --mode=daily"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.85.5",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^0.468.0",
    "next": "^15.5.2",
    "next-intl": "^4.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
